# Dynamic tapping term — adjust on the fly while dialing in timing.
# Use DT_UP/DT_DOWN (±5ms) and DT_PRNT to check current value.
# Remove this line once you've settled on your tapping term.
DYNAMIC_TAPPING_TERM_ENABLE = yes

# Caps Word — auto-disables caps after finishing a WORD_LIKE_THIS
CAPS_WORD_ENABLE = yes

# Key Overrides - allows defining ways to ignore/override specific key inputs
KEY_OVERRIDE_ENABLE = yes
